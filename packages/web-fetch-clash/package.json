{
  "name": "@inlve/dsh-web-fetch-clash",
  "version": "0.2.2",
  "description": "Fake-IP aware web.fetch provider for DeepSeek Harness: asks Clash for the truthful resolution, validates it, and pins the connection",
  "license": "MIT",
  "author": "Inlve",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inlve/dsh-plugins.git",
    "directory": "packages/web-fetch-clash"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "clash",
    "mihomo",
    "fake-ip",
    "tun"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test test/basic.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
