{
  "name": "@inlve/dsh-mcp-panel",
  "version": "0.2.0",
  "description": "Visual MCP server manager for DSH: add, edit and delete servers, see a green/red connection dot with the failure reason, and click the dot to probe again",
  "license": "MIT",
  "author": "Inlve",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inlve/dsh-plugins.git",
    "directory": "packages/mcp-panel"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "mcp-server",
    "panel",
    "settings"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-0 <0.3.0-0"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
